{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/dev/doc/**": "allow",
      "~/dev/seqix/**": "allow",
      "~/dev/pairix/**": "allow",
      "~/dev/chess-counter/**": "allow"
    },
    "read": {
      "~/dev/doc/**": "allow",
      "~/dev/seqix/**": "allow",
      "~/dev/pairix/**": "allow",
      "~/dev/chess-counter/**": "allow"
    },
    "edit": {
      "~/dev/doc/**": "allow"
    },
    "bash": {
      "cat *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "mkdir ~/dev/doc*": "allow",
      "ls ~/dev/doc*": "allow",
      "git commit *": "allow"
    }
  }
}
